# Backend base URL. Leave unset for demo mode (simulated pipeline + sample result).
# With the vite dev server, "/api" is proxied to http://127.0.0.1:8000 (see vite.config.ts),
# so for local dev you can also leave this unset once the backend exists and use relative /api.
# For a deployed backend (Render), set e.g.:
# VITE_API_BASE=https://clipsense-api.onrender.com
