# Copy to .env and fill in. Never commit real keys (plan §14).

# Provider for the Vision Agent: "gemini" (plan) or "groq" (prototype)
VISION_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=

# Model IDs — keep configurable, providers retire models
VISION_MODEL_GROQ=qwen/qwen3.8-27b
VISION_MODEL_GEMINI=gemini-2.5-flash

# Vision pipeline limits
MAX_VISION_FRAMES=25
VISION_WORKERS=1
FRAME_SAMPLE_INTERVAL=4.0
MAX_PROCESS_SECONDS=600
FRAME_MAX_WIDTH=960

# OCR
USE_EASYOCR=true
EASYOCR_LANGUAGES=en
OCR_MIN_CONFIDENCE=0.35

# ASR fallback: "faster_whisper" (local, free) or "groq" (API)
ASR_PROVIDER=faster_whisper
ASR_MODEL_GROQ=whisper-large-v3-turbo
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_DEVICE=auto
FASTER_WHISPER_COMPUTE=int8
ASR_CHUNK_SECONDS=600
